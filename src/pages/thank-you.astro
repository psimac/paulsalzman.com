---
import Base from '../layouts/Base.astro';
---

<Base
  title="Thank you | Paul Salzman"
  description="Your message has been sent."
  path="/thank-you/"
  noindex
>
  <main id="main" class="simple wrap">
    <div>
      <p class="mono">Message sent</p>
      <h1 class="serif">Thank <em>you.</em></h1>
      <p>Your message is on its way. I’ll get back to you soon.</p>
      <a class="btn" href="/"><span aria-hidden="true">←</span> Back to the site</a>
    </div>
  </main>
</Base>
