---
import Base from '../layouts/Base.astro';

const title = 'Paul Salzman | Founder, Builder, Writer';
const description =
  'Paul Salzman. Founder of Wheelio and CreativeHydra. More than twenty years in technology and business management, building companies, fixing the ones that are stuck, and writing about it.';

// Latest posts from the blog, fetched when the site is built.
// If the feed cannot be reached, the build falls back to this list.
type Post = { title: string; url: string; date: string };

const fallbackPosts: Post[] = [
  {
    title: 'The Three-Month Test',
    url: 'https://blog.paulsalzman.com/the-three-month-test/',
    date: '2026-10-05',
  },
  {
    title: 'Squirrel Torque',
    url: 'https://blog.paulsalzman.com/squirrel-torque/',
    date: '2026-06-23',
  },
  {
    title: 'Grumble and Renew: The Hidden Economics Destroying Margins',
    url: 'https://blog.paulsalzman.com/grumble-and-renew-the-hidden-economics-destroying-margins/',
    date: '2026-05-21',
  },
];

async function latestPosts(): Promise<Post[]> {
  try {
    const res = await fetch('https://blog.paulsalzman.com/rss/', {
      signal: AbortSignal.timeout(8000),
    });
    if (!res.ok) return fallbackPosts;
    const xml = await res.text();
    const text = (s: string) =>
      s
        .replace(/^<!\[CDATA\[/, '')
        .replace(/\]\]>$/, '')
        .trim();
    const posts = [...xml.matchAll(/<item>([\s\S]*?)<\/item>/g)]
      .slice(0, 3)
      .map((m) => {
        const item = m[1];
        const t = item.match(/<title>([\s\S]*?)<\/title>/)?.[1];
        const l = item.match(/<link>([\s\S]*?)<\/link>/)?.[1];
        const d = item.match(/<pubDate>([\s\S]*?)<\/pubDate>/)?.[1];
        if (!t || !l || !d) return null;
        const url = text(l);
        if (!url.startsWith('https://blog.paulsalzman.com/')) return null;
        return { title: text(t), url, date: new Date(d).toISOString().slice(0, 10) };
      })
      .filter((p): p is Post => p !== null);
    return posts.length ? posts : fallbackPosts;
  } catch {
    return fallbackPosts;
  }
}

const posts = await latestPosts();
const fmt = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});

const work = [
  {
    when: 'Now',
    name: 'Wheelio',
    role: 'Founder',
    text: 'A search engine for cars. It treats car shopping as a matching problem and brings buyers to dealers.',
    url: 'https://wheelio.com',
  },
  {
    when: '2016 to now',
    name: 'CreativeHydra',
    role: 'Founder',
    text: 'Business systems, AI consulting, and websites for small and mid-sized businesses. Home of FLOW, an assessment that shows where work stalls and what to fix first.',
    url: 'https://www.creativehydra.com',
  },
  {
    when: '2023 to 2025',
    name: 'Porsche Seattle North',
    role: 'Sales Executive and Certified Brand Ambassador',
    text: 'Joined the founding team of a new location and helped set its customer service standards.',
  },
  {
    when: '2008 to 2016',
    name: 'Apple',
    role: 'Business Specialist, Visuals Expert, Sales Specialist',
    text: 'Eight years in Greater Seattle and Southern California. Helped open three new stores.',
  },
  {
    when: '2014',
    name: 'SOScharger',
    role: 'Co-developer and primary designer',
    text: 'A hand-crank charger for mobile phones. It earned U.S. design patent D698,311.',
    url: 'https://patents.google.com/patent/USD698311S1',
  },
  {
    when: 'Earlier',
    name: 'HydraMedia',
    role: 'Co-founder',
    text: 'A web development and affiliate marketing company in Kirkland, WA.',
  },
  {
    when: 'Earlier',
    name: 'Print and podcasts',
    role: 'Columnist and host',
    text: 'Columnist and story writer for Computer Source and Computer Consumer magazines. Host of Autotalk, an early automotive podcast, and Vexed Tech.',
  },
];

const beliefs = [
  {
    name: 'Clarity',
    text: 'See what is actually happening inside a business before changing anything.',
  },
  {
    name: 'Alignment',
    text: 'Get people, systems, and decisions pointed the same way.',
  },
  {
    name: 'Execution',
    text: 'Turn the plan into simple routines that hold up on a busy day.',
  },
];

const life = [
  {
    label: 'Volunteer',
    name: 'Porsche Club of America',
    text: 'Social Co-Chair for the Pacific Northwest Region since July 2023. I help build community and organize events in one of the club’s most active chapters.',
    link: 'pnwr.org',
    url: 'https://pnwr.org',
  },
  {
    label: 'On the air',
    name: 'W7VLT',
    text: 'Licensed amateur radio operator in the Puget Sound area.',
    link: 'Mastodon',
    url: 'https://mastodon.sdf.org/@psimac',
    rel: 'me',
  },
  {
    label: 'Advisory',
    name: 'Fractional CSO / COO',
    text: 'Senior strategy and operations help for founders and growth-stage companies.',
    link: 'Get in touch',
    url: '#contact',
  },
  {
    label: 'Local',
    name: 'Mobile Notary',
    text: 'Certified mobile notary serving King and Snohomish Counties.',
    link: 'notary.paulsalzman.com',
    url: 'https://notary.paulsalzman.com',
  },
];

const socials = [
  { name: 'LinkedIn', url: 'https://www.linkedin.com/in/paulsalzman/' },
  { name: 'Instagram', url: 'https://www.instagram.com/psimac/' },
  { name: 'Porsche IG', url: 'https://www.instagram.com/porschepaulpnw/' },
  { name: 'X', url: 'https://x.com/psimac' },
  { name: 'YouTube', url: 'https://www.youtube.com/@psimac' },
  { name: 'Mastodon', url: 'https://mastodon.sdf.org/@psimac', rel: 'me' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://paulsalzman.com/#person',
      name: 'Paul Salzman',
      url: 'https://paulsalzman.com',
      image: 'https://paulsalzman.com/images/paul-salzman-1200.webp',
      jobTitle: 'Founder',
      description:
        'Founder of Wheelio and CreativeHydra, with more than twenty years in technology and business management.',
      sameAs: socials.map((s) => s.url).concat('https://blog.paulsalzman.com'),
      worksFor: [
        { '@type': 'Organization', name: 'Wheelio', url: 'https://wheelio.com' },
        { '@type': 'Organization', name: 'CreativeHydra', url: 'https://www.creativehydra.com' },
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://paulsalzman.com/#website',
      url: 'https://paulsalzman.com',
      name: 'Paul Salzman',
      publisher: { '@id': 'https://paulsalzman.com/#person' },
    },
  ],
};
---

<Base title={title} description={description}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="#top">Paul Salzman<span>.</span></a>
      <nav class="nav mono" aria-label="Primary">
        <a href="#about">About</a>
        <a href="#work">Work</a>
        <a href="#beliefs">Beliefs</a>
        <a href="#writing">Writing</a>
        <a href="#life">Life</a>
        <a class="out" href="https://blog.paulsalzman.com">Ich Spreche</a>
      </nav>
      <a class="pill mono" href="#contact">Say hello</a>
    </div>
  </header>

  <main id="main">
    <section class="hero wrap" id="top">
      <div class="hero-grid">
        <div>
          <p class="eyebrow mono">
            <b>Paul Salzman</b>
            <span>Greater Seattle</span>
          </p>
          <h1 class="serif">Hi, I’m <em>Paul.</em></h1>
          <p class="lede">
            <strong>I start companies, fix the ones that are stuck, and write about what I learn.</strong>
            {' '}More than twenty years in technology and business management. Founder of Wheelio
            and CreativeHydra. Car guy in the Pacific Northwest.
          </p>
          <div class="hero-cta">
            <a class="btn" href="#work">What I’ve done <span aria-hidden="true">↓</span></a>
            <a class="link" href="#contact">Say hello</a>
          </div>
        </div>

        <figure class="portrait">
          <img
            src="/images/paul-salzman-1200.webp"
            srcset="/images/paul-salzman-600.webp 600w, /images/paul-salzman-1200.webp 1200w"
            sizes="(min-width: 760px) 36vw, 90vw"
            width="1200"
            height="1500"
            alt="Paul Salzman sitting on stone steps outside a cabin in the woods"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    <div class="wrap">
      <ul class="facts mono">
        <li>Founder, Wheelio</li>
        <li>Founder, CreativeHydra</li>
        <li>20+ years in technology & business</li>
        <li>Patent holder</li>
      </ul>
    </div>

    <section class="section wrap" id="about">
      <div class="section-head reveal">
        <p class="mono"><b>01</b> / About</p>
        <h2 class="serif">The short version</h2>
      </div>
      <div class="split">
        <div class="body reveal">
          <div class="prose">
            <p>
              I’ve spent more than twenty years in <strong>technology and business management</strong>.
              In that time I’ve started companies, helped open three Apple stores, joined the
              founding team of a Porsche dealership, designed a product that earned a patent, and
              written about all of it along the way.
            </p>
            <p>
              The thread through it is simple. <strong>I like finding where things get stuck and
              making them work again.</strong> Sometimes that is a business. Sometimes it is a
              workflow, a team, or the way people shop for a car.
            </p>
            <p>
              Today I’m building Wheelio, running CreativeHydra, and advising founders and
              operators who feel their company has drifted.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section wrap" id="work" style="padding-top:0">
      <div class="section-head reveal">
        <p class="mono"><b>02</b> / Work</p>
        <h2 class="serif">What I’ve done</h2>
      </div>
      <ol class="rows">
        {
          work.map((w) => (
            <li class="row timeline reveal">
              <span class="row-when mono">{w.when}</span>
              <span>
                <span class="row-title">
                  {w.url ? (
                    <a href={w.url}>
                      {w.name} <span class="row-arrow" aria-hidden="true">↗</span>
                    </a>
                  ) : (
                    w.name
                  )}
                </span>
                <span class="row-meta mono">{w.role}</span>
              </span>
              <span class="row-desc">{w.text}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section wrap" id="beliefs" style="padding-top:0">
      <div class="section-head reveal">
        <p class="mono"><b>03</b> / Beliefs</p>
        <h2 class="serif">Less is more</h2>
      </div>
      <div class="split">
        <div class="body reveal">
          <div class="prose">
            <p>
              I believe that less is more when it comes to business.{' '}
              <strong
                >Removing the complications from a workflow and editing a business down to its
                bare metal is a huge challenge.</strong
              >
              {' '}It is also where most of the value is.
            </p>
            <p>
              Organizations drift. Decisions stall, teams pull in different directions, and the
              work gets heavy. Companies succeed or fail on how well their people, systems, and
              decisions line up. I’m a longtime follower of Michael Gerber’s <em>E-Myth</em>, and I
              build my own businesses and my clients’ businesses on that thinking.
            </p>
          </div>
        </div>
      </div>

      <div class="drift" aria-hidden="true">
        <svg data-drift preserveAspectRatio="none">
          <path d=""></path>
        </svg>
        <div class="drift-labels mono">
          <span>Drift</span>
          <span>Flow</span>
        </div>
      </div>

      <div class="fixes">
        {
          beliefs.map((f, i) => (
            <article class="fix reveal" style={`--d:${i * 0.1}s`}>
              <p class="mono">{`0${i + 1}`}</p>
              <h3>{f.name}</h3>
              <p>{f.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section wrap" id="writing" style="padding-top:0">
      <div class="section-head reveal">
        <p class="mono"><b>04</b> / Writing</p>
        <h2 class="serif">What I’m thinking about</h2>
      </div>
      <div class="split">
        <div class="body">
          <p class="prose reveal" style="margin-bottom:2.5rem">
            I write about business, leadership, technology, and the car industry on my blog,{' '}
            <strong>Ich Spreche</strong>. Here are the latest posts.
          </p>
          <div class="rows">
            {
              posts.map((p) => (
                <a class="row reveal" href={p.url}>
                  <span>
                    <span class="row-title">{p.title}</span>
                  </span>
                  <time class="row-desc mono" datetime={p.date}>
                    {fmt.format(new Date(p.date))}
                  </time>
                  <span class="row-arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
              ))
            }
          </div>
          <div class="more reveal">
            <a class="link" href="https://blog.paulsalzman.com">All posts on Ich Spreche</a>
            <a class="link" href="https://medium.com/@psimac">Essays on Medium</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section wrap" id="life" style="padding-top:0">
      <div class="section-head reveal">
        <p class="mono"><b>05</b> / Life</p>
        <h2 class="serif">Cars, radios, and community</h2>
      </div>
      <div class="cards reveal">
        {
          life.map((c) => (
            <article class="card">
              <p class="mono">{c.label}</p>
              <h3>{c.name}</h3>
              <p>{c.text}</p>
              <a class="link" href={c.url} rel={c.rel}>
                {c.link}
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="contact" id="contact">
      <div class="wrap contact-grid">
        <div class="reveal">
          <p class="mono">Contact</p>
          <h2 class="serif">Say <em>hello.</em></h2>
          <p>
            If you want to talk about a business that feels stuck, an idea, or cars, I’d like to
            hear from you.
          </p>
          <p class="direct">
            Or email directly:{' '}
            <a class="link" href="mailto:paul@paulsalzman.com">paul@paulsalzman.com</a>
          </p>
        </div>

        <form
          class="form reveal"
          name="contact"
          method="POST"
          action="/thank-you/"
          data-netlify="true"
          netlify-honeypot="bot-field"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hp">
            <label>Don’t fill this out if you’re human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>
          <div class="field">
            <label class="mono" for="name">Name</label>
            <input id="name" name="name" type="text" autocomplete="name" placeholder="Your name" required />
          </div>
          <div class="field">
            <label class="mono" for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" placeholder="you@company.com" required />
          </div>
          <div class="field">
            <label class="mono" for="message">Message</label>
            <textarea id="message" name="message" rows="4" placeholder="What’s on your mind?"></textarea>
          </div>
          <button class="btn" type="submit">Send message <span aria-hidden="true">→</span></button>
        </form>
      </div>
    </section>
  </main>

  <footer class="site-footer mono">
    <div class="wrap">
      <p>© {new Date().getFullYear()} Paul Salzman</p>
      <ul>
        {
          socials.map((s) => (
            <li>
              <a href={s.url} rel={s.rel}>
                {s.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </footer>

  <script>
    // The drift line: unsteady on the left, straight on the right.
    // It settles as the visitor scrolls into the page.
    const svg = document.querySelector<SVGSVGElement>('[data-drift]');
    const path = svg?.querySelector('path');
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (svg && path) {
      let visible = true;
      const draw = (t: number) => {
        const w = svg.clientWidth;
        const mid = svg.clientHeight / 2;
        const calm = Math.min(1, window.scrollY / (window.innerHeight * 0.7));
        let d = '';
        for (let x = 0; x <= w; x += 6) {
          const p = x / w;
          const amp = (mid - 4) * Math.pow(1 - p, 1.6) * (1 - calm * 0.85);
          const y =
            mid +
            amp *
              (0.6 * Math.sin(x * 0.021 + t * 0.0011) +
                0.4 * Math.sin(x * 0.047 - t * 0.0017));
          d += `${x ? 'L' : 'M'}${x} ${y.toFixed(1)}`;
        }
        path.setAttribute('d', d);
      };

      if (still) {
        draw(0);
        window.addEventListener('resize', () => draw(0));
      } else {
        new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(svg);
        const tick = (t: number) => {
          if (visible) draw(t);
          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    }

    // Reveal sections as they scroll into view.
    const items = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      items.forEach((el) => io.observe(el));
    } else {
      items.forEach((el) => el.classList.add('in'));
    }
  </script>
</Base>
