---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found | Paul Salzman"
  description="That page could not be found."
  path="/404"
  noindex
>
  <main id="main" class="simple wrap">
    <div>
      <p class="mono">Error 404</p>
      <h1 class="serif">Off <em>course.</em></h1>
      <p>That page has drifted away or never existed.</p>
      <a class="btn" href="/"><span aria-hidden="true">←</span> Back to the site</a>
    </div>
  </main>
</Base>
